# --- Python 虚拟环境（依赖的真源是 pyproject.toml，pip install -e ".[all]" 复现）---
.venv/
venv/
env/

# --- Python 缓存与编译产物 ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/

# --- 密钥 / 配置（务必不要提交真实密钥）---
.env
.env.*
!.env.example
*.key

# --- 生成的数据库文件（可由脚本重建）---
*.db
*.sqlite
*.sqlite3

# --- 日志与临时文件 ---
*.log
*.tmp

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- 工具缓存 ---
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- 个人文件（与本项目无关且含隐私信息，禁止入库）---
简历*.md
简历*.pdf
简历*.docx
简历*.txt

# --- 第三方参考项目压缩包（二进制无法 diff，且含他人许可证）---
*.zip
*.7z
*.rar
*.tar.gz

# --- RAG 管道生成的检索产物（用 python -m traffic_law_qa.pipeline build 重建）---
法规知识库/chunks/
法规知识库/index/

# --- 评测跑出来的轨迹（几十到几百 K 的 JSON，随时能用 --trace 重跑）---
data/traces/

# --- 上游原始素材（下载件）---
# 管道只读 docx，pdf 谁都不读；要入库得先转成 docx 放进 docx/。
# 它是可重新下载的，不像 docx 那样是「改过就没了」的真源，所以不占版本库。
法规知识库/pdf/

# --- Milvus 容器数据卷（docker compose 生成，体积大且可重建）---
volumes/
