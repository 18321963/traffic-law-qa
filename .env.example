# 复制为 .env 后填入真实密钥。.env 已被 .gitignore 忽略，切勿提交。

# ---------- 生成模型（OpenAI 兼容端点）----------
# 通义百炼: https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus / qwen3.8-flash / qwen3.8-max
# DeepSeek: https://api.deepseek.com/v1   model=deepseek-chat
# 智谱:     https://open.bigmodel.cn/api/paas/v4   model=glm-4-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.2

# ---------- 向量模型 ----------
# 用百炼时 LLM 与 Embedding 是同一个 key，EMBED_API_KEY 留空即可（会自动回退到 LLM_API_KEY）。
# 注意：DeepSeek 不提供 embedding 接口，混用时必须单独配一家（通义百炼 / 智谱 / OpenAI）。
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
# 通义 text-embedding-v4 / 智谱 embedding-3 / OpenAI text-embedding-3-small
EMBED_MODEL=text-embedding-v4
# 向量维度；留空则使用模型默认维度，首次建库后会写回 index/index_meta.json
EMBED_DIM=1024
# 单次请求最多提交多少条文本（各家限制不同，通义 v4 为 10）
EMBED_BATCH=10

# ---------- 检索参数 ----------
# 最终返回给 LLM 的法条数（父块，按条计）
RAG_TOP_K=6
# 每个召回通道各取多少候选
RAG_CANDIDATES=20
# Milvus RRFRanker 的平滑常数
RAG_RRF_K=60
# 查询命中法名片段（如"深圳""智能网联汽车"）时，对应法规条文的分数加成；设为 1.0 关闭
RAG_LAW_HINT_BOOST=1.5

# ---------- Milvus（先 docker compose up -d）----------
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=traffic_law
# 文本分析器：jieba 支持中文分词；置空则用 standard（中文会退化成单字，不推荐）
MILVUS_ANALYZER=jieba
# BM25 参数：k1 控制词频饱和（推荐 1.2~2.0），b 控制长度归一化（0~1）
MILVUS_BM25_K1=1.2
MILVUS_BM25_B=0.75
