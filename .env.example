
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-flash
LLM_TEMPERATURE=0.2

# 嵌入与重排都在进程内跑（transformers + 本地权重 法规知识库/models/），没有远端端点。
# 默认路径就是下面两个模型的目录名，换模型才需要设：
# EMBED_MODEL=            # 默认 <包同级>/法规知识库/models/bge-m3
EMBED_BATCH=10
EMBED_MAX_LENGTH=512
EMBED_DEVICE=auto
EMBED_DTYPE=auto

# 建库时会记下嵌入权重的指纹（模型目录里「相对路径 + 文件大小 + mtime」的摘要），启动时对不上就拒绝服务
# （POST /reindex 或下面这个开关可显式放行，放行即重建一次并写入新指纹）。
# 它是启发式：防误换（换模型、换目录、残缺拷贝），不防篡改——同样大小的字节改写认不出来，要内容级校验得另做离线脚本。
# 老快照没记指纹时只降级不拦：照常服务，/health 报 weights=unknown、degraded=true。
# 误报最常见的一种：模型目录是拷贝或解压来的，mtime 是拷贝那一刻而不是原始时间——换机、重新拷贝都会翻新；
# 遇上时不用改代码，RAG_ALLOW_REBUILD=1 重建一次即可，新快照会写入新指纹。
# RAG_ALLOW_REBUILD=1

RAG_TOP_K=6
# 单次检索的候选池大小（融合后、重排前），同时是 POST /qa 的 pool 参数上限
RAG_CANDIDATES=20
RAG_POOL_MAX=50
RAG_RRF_K=60
RAG_LAW_HINT_BOOST=1.5
# 检索重活的并发闸：同时处理请求数上限（0 = 关）与排队超时秒数（超时 sync 面 503、流式面 error 帧）
RAG_MAX_CONCURRENCY=4
RAG_QUEUE_TIMEOUT=30.0

# RRF 之后接交叉编码器重排（bge-reranker-v2-m3）；RAG_RERANK=0 退回纯融合序
RAG_RERANK=1
# 0 = 整池重排（score 口径统一）；设 k 只重排前 k 篇
RAG_RERANK_TOP_N=0
RAG_RERANK_BATCH=8
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_DEVICE=auto
RAG_RERANK_DTYPE=auto
# RAG_RERANK_MODEL=      # 默认 <包同级>/法规知识库/models/bge-reranker-v2-m3

AGENT_MAX_STEPS=3
AGENT_MAX_EVIDENCE=0
AGENT_SNIPPET_CHARS=120
AGENT_ARTICLE_CHARS=400
AGENT_TEMPERATURE=0.0
AGENT_RETRIES=2
AGENT_REGION_BASE_URL=
AGENT_REGION_API_KEY=
AGENT_REGION_MODEL=
AGENT_REVIEW_BASE_URL=
AGENT_REVIEW_API_KEY=
AGENT_REVIEW_MIN_SCORE=0.6
AGENT_REVIEW_MODEL=

# 会话短期记忆的 SQLite 文件（默认 data/sessions.db，与台账、材料同目录；容器里靠卷持久化）
# AGENT_SESSION_DB=

# 地区澄清（人在环）：问题里出现具体地区时先中断问一句「按该地法规还是只按全国法」再作答。
# 代码默认关（离线评测与裸调不受影响）；deploy compose 的 agent 服务与 Studio 都显式开。
AGENT_CLARIFY=0

# 跨轮记忆回溯的轮数：提示词里带最近 N 轮问答（历史答案截 300 字）
AGENT_HISTORY_TURNS=5

# 工具调用超时（秒）：超时以「检索失败」回执交回模型换招
AGENT_TOOL_TIMEOUT=15.0

# 生产面护栏（默认全关，向后兼容）。鉴权：逗号分隔 key 列表，非空时除 /health、/laws 外都要带 X-API-Key
# AGENT_API_KEYS=
# 按 key 分钟级限流：超限 429 + Retry-After（0 = 关）
AGENT_RATE_LIMIT_RPM=30
# 全局日 token 额度：达额 429；账本在 data/usage.db（0 = 关）
AGENT_DAILY_TOKEN_BUDGET=0
# 会话保留天数：过期 thread 可被容器内 CLI 清掉（0 = 不清理）
AGENT_SESSION_TTL_DAYS=30

# 跨源放行（只挂在 agent 服务，rag 不挂）：浏览器 Origin 白名单，逗号分隔。
# 留空 = 默认放行本地前端的 localhost / 127.0.0.1 × 5173 / 4173 四个源；只放行 Content-Type 与 X-API-Key 两个请求头。
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 轨迹环境标记（UI 按 environment 过滤）：跑批 eval.multihop 自动记 eval；服务侧要标就填，不填用兜底值
# LANGFUSE_TRACING_ENVIRONMENT=production

BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_COUNT=5
BOCHA_FRESHNESS=noLimit
BOCHA_TIMEOUT=15.0

MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=traffic_law
MILVUS_ANALYZER=jieba
MILVUS_BM25_K1=1.2
MILVUS_BM25_B=0.75
