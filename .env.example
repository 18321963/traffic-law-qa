# 复制为 .env 后填入真实密钥。.env 已被 .gitignore 忽略，切勿提交。

# ---------- 生成模型（OpenAI 兼容端点）----------
# 通义百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1   model=deepseek-chat
# 智谱:     https://open.bigmodel.cn/api/paas/v4   model=glm-4-plus
#
# 免费额度按**模型**算，耗尽时返回 403 Free quota exhausted —— 换个模型即可，不必换 key。
# 2026-09-19 实测这份 key 的状态：
#
#   qwen3-max    额度耗尽   ← DESIGN 里那些基线数字当初就是用它测的，现在复现不出来了
#   qwen-plus    额度耗尽
#   qwen-max     可用      ← 默认取它：同为旗舰档，是 qwen3-max 最接近的替身
#   qwen-flash   可用      ← 最快
#   qwen-turbo   可用
#
# **别只看单次问答的速度挑模型**，那条路径量不出真差距。同一道多跳题跑完整路径
# （检索 + 生成 + agent 循环）实测：
#
#   qwen-flash   6.0s   |  qwen-max  14.0s  |  qwen3.8-max  **276.5s**
#
# qwen3.8-max 在只有一两句的短问答上只比 qwen-flash 慢 2.6 倍，但上下文一长
# （检索出的证据、工具返回）就慢到 **46 倍** —— 思考模型的推理开销随上下文放大。
# 63 题的多跳评测用它要 4.8 小时，用 qwen-max 只要 20~35 分钟。
#
# 也别为了快就挑 qwen-flash：agent 那一臂的价值本来就建立在**多轮规划**上，
# 小模型在这上面明显退化，会把要对比的东西本身削弱。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-max
LLM_TEMPERATURE=0.2

# ---------- 向量模型 ----------
# 默认指向**本地 Ollama**：README 里那组 hit@k 就是用它测的，云端换模型复现不出同一组数。
# 装法见本文件末尾「本地模型」一节。不想装 Ollama 就改用下面注释掉的云端配置。
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
# 注意模型名带命名空间：bge-large-zh-v1.5 在 Ollama 上没有官方库，只有社区仓库，
# 所以 pull 时要连 `dengcao/` 一起写，只写 bge-large-zh-v1.5 会 404。
# （拉不到就退回官方库的 bge-m3，同为 1024 维，两个名称都无需命名空间。）
EMBED_MODEL=dengcao/bge-large-zh-v1.5
# 向量维度：**本地端点必须留空**。非空会作为 dimensions 参数发给端点，Ollama 不认会 400。
# 维度不靠它定 —— kb/indexer.py 是从实际返回的向量长度推 dim 再建 schema 的。
EMBED_DIM=
# 单次请求最多提交多少条文本。本地没有服务商侧的条数限制，调大只是少几次往返。
EMBED_BATCH=32
# 只加在**查询**上的指令前缀，段落侧绝不加。bge-zh 系列就是按这个用法训练的。
# 135 题实测（同一索引，只差这一项）：hit@1 69.6%→71.1%、hit@6 87.4%→90.4%、
# MRR 0.7667→0.7826，hit@3 持平 —— 四项里三项变好、一项不动，所以默认开着。
# 换成 text-embedding-v4 这类不吃前缀的模型时留空即可，空值 = 与加这功能之前逐位相同。
# 改它**不需要重建索引**：只影响查询怎么编码，库里的段落向量与它无关。
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
#
# === 云端向量（text-embedding-v4 / 智谱 embedding-3 / OpenAI text-embedding-3-small）===
# 注意：DeepSeek 不提供 embedding 接口，混用时必须单独配一家。
# **别图省事把 EMBED_API_KEY 留空** —— 留空会回退吃 LLM_API_KEY（config.embed_config 的兜底），
# 于是「换个生成模型」会顺手把向量侧也打断，而 traffic_law 集合是用 EMBED_MODEL 建的。
# 换向量模型 = 全库重建 + 既有基线数字全部作废 —— 这一步现在**会**自动发生：
# api.py 的 _stale_reason 会比对快照里的 embedding_model 与当前配置，不一致就重建。
# （补这条之前它是静默的：v4 与 bge-large 都是 1024 维，行数也不变，一路放行。）
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v4
# EMBED_DIM=1024
# EMBED_BATCH=10
# 云端这家不吃指令前缀，**留空**。（前缀不进 embedding_model 快照，所以切模型时
# _stale_reason 不会因为这一项判过期 —— 这是对的，它只影响查询编码，动不了库里的向量。）
# EMBED_QUERY_PREFIX=

# ---------- 检索参数 ----------
# 最终返回给 LLM 的法条数（父块，按条计）
RAG_TOP_K=6
# 每个召回通道各取多少候选
RAG_CANDIDATES=20
# Milvus RRFRanker 的平滑常数
RAG_RRF_K=60
# 查询命中法名片段（如"深圳""智能网联汽车"）时，对应法规条文的分数加成；设为 1.0 关闭
RAG_LAW_HINT_BOOST=1.5

# ---------- Agent 循环（阶段二，仅 `python -m traffic_law_rag.agent` 用）----------
# 线性管道 qa(mode="ask") 不读这一段，改了不影响基线。
# 循环参数只由这里说了算；检索参数（上面那组 RAG_*）仍是唯一真源 ——
# Agent 不许悄悄换一套检索参数，否则和基线的对照就不是同一个检索了。
# 规划轮数上限（= LLM 规划调用次数上限）。规则取条那条路不耗这个预算。
# 默认 2 是实测定的，不是拍的：100 题多跳集上第 2 轮把条目级命中从 72/200 抬到 78/200，
# 第 3 轮只再抬 2 条（78→80），却多花 35 次检索 + 35 次规划 + 35 次审核。调到 3 基本是白花钱。
# 想复现旧行为就显式写 3。
AGENT_MAX_STEPS=2
# 最终证据条数；0 = 沿用 RAG_TOP_K
AGENT_MAX_EVIDENCE=0
# 搜索结果里每条法条的摘要字数
AGENT_SNIPPET_CHARS=120
# 精确取条（get_article）的摘要字数，比检索摘要大：用户点名要看这一条，
# 切太短会把列举型法条里的关键项切掉
AGENT_ARTICLE_CHARS=400
# 规划轮温度：要它稳定选词，不要它发挥
AGENT_TEMPERATURE=0.0
AGENT_RETRIES=2

# ---------- 审核节点专用模型（可选）----------
# 审核是整个循环里唯一一个「判断题 + 严格 JSON 输出」的节点，也是实测唯一有明显判断
# 缺口的地方：100 题里 162 次真判定有 64 次误报（证据明明够了却判「不够」）。规划轮
# 反而很听话（第 2 轮检索词平均 68% 的字符落在上轮 missing 里），不用换 ——
# 所以只把审核这一半摘出去，规划轮仍用上面的 LLM_*。
#
# 三项**逐字段回退**到 LLM_*：不写 = 与单模型时逐位相同；写了哪项才覆盖哪项。
# 同一家、只想换个免费额度没用完的模型时，只写 AGENT_REFLECT_MODEL 就行
# （百炼的免费额度是按模型算的）。
#
# ⚠️ 但**模型名不跨家**：下面这个 glm-4.7-flash 只能配智谱的 base_url。只改模型名而
#    base_url 还指着百炼的话，端点会直接 400 —— 好在失败是响的，不会静默劣化。
#
# 智谱 GLM-4.7-Flash：永久免费（不限量，不是送额度），混合思考模型，30B 总 / 3B 激活，
# 官方称在 SWE-bench Verified 与 τ²-Bench 上强过 gpt-oss-20b 与 Qwen3-30B-A3B-Thinking。
# 到 https://open.bigmodel.cn 注册拿 key。免费档有独立并发限速，被限会 429。
# AGENT_REFLECT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENT_REFLECT_API_KEY=
# AGENT_REFLECT_MODEL=glm-4.7-flash
#
# 一个坑先记在这：思考模型把思维链放在 reasoning_content、正文仍是干净 JSON，客户端
# 吃得下。但若换成把思考**塞进正文**的端点，思维链里的花括号会让 `_parse_reflection`
# 的「首个 { 到末个 }」取错范围 —— 而它的兜底是 sufficient=True（停止），表现为循环
# 静默退化成单轮。真换的时候先看轨迹里的审核轮数。

# ---------- Milvus（先 docker compose up -d standalone）----------
# 这个 localhost 是给**宿主机裸跑**（pip install -e . 后直接 python -m ...）用的。
# 跑在容器里时 localhost 指容器自己，必须换成服务名 —— docker-compose.yml 的 app
# 服务已经在 environment 里覆盖成 http://standalone:19530，这里不用改。
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=traffic_law
# 文本分析器：jieba 支持中文分词；置空则用 standard（中文会退化成单字，不推荐）
MILVUS_ANALYZER=jieba
# BM25 参数：k1 控制词频饱和（推荐 1.2~2.0），b 控制长度归一化（0~1）
MILVUS_BM25_K1=1.2
MILVUS_BM25_B=0.75

# ---------- 本地模型（Ollama）----------
# 向量侧**默认就走这里**（见上面「向量模型」一节）；这一节说怎么装，以及要不要
# 把「生成」也搬过来。两个 client 都是纯 OpenAI 兼容接口（/chat/completions 与
# /embeddings），换本地只是改地址，代码零改动。
#
# 本机实测：RTX 3050 Laptop / **4GB 显存**。
#
#   ollama pull dengcao/bge-large-zh-v1.5   # 向量：326M 参数 / FP16 约 650MB
#   装到 D 盘（C 盘紧张时）：安装器带 /DIR，模型另用 OLLAMA_MODELS 指过去 ——
#   后者是**服务启动时**读的，改完要重启 ollama 才生效。
#
# 早先这版注释写的是「4GB 上只能配 bge-small-zh-v1.5」，那有个前提：**同时**在本地
# 跑生成模型。只跑向量时 650MB 对 4GB 绰绰有余，这个取舍不必做 —— bge-small 只有
# 24M 参数，中文检索质量比 bge-large 差一截。
#
# bge-large-zh-v1.5 在 Ollama 上只有社区仓库（dengcao/ 、tisandman/ 等），没有官方版。
# 拉不到就退回官方库的 bge-m3（1.2GB / 同为 1024 维），后续步骤完全不变。
#
# === 可选：生成也本地化（与向量共用一张卡时要算总账）===
#   ollama pull qwen3:4b      # Q4 量化约 2.5GB
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama          # 非空即可 —— config 的 ready 就是 bool(api_key)，Ollama 不校验
# LLM_MODEL=qwen3:4b
# 此时 bge-large（约 650MB）+ qwen3:4b（约 2.5GB）≈ 3.2GB，加 KV cache 逼近 4GB，
# 得设 OLLAMA_MAX_LOADED_MODELS=1 让两者换入换出（慢，但能跑）。
#
# 换生成模型不动任何既有数字 —— 评测的 135 题与 100 题两条臂**根本不调用 LLM**。
# 换向量模型正相反：traffic_law 集合必须全库重建、既有基线全部作废
#（现在这一步会自动发生，_stale_reason 会比对快照里的 embedding_model）。
#
# 两条注意：
# 1) agent 那条路走 OpenAI 工具调用协议，需要模型支持 function calling。
#    qwen3 系列支持，但 4B 这么小的模型多轮规划会明显退化 —— 而 100 题对照
#    已经证明 agent 的价值本来就在多轮检索上。纯问答 qa(mode="ask") 没这要求。
# 2) 显存不够时 Ollama 会溢出到共享内存，速度崩到 1~3 tok/s。可用
#    OLLAMA_MAX_LOADED_MODELS=1 与 OLLAMA_KV_CACHE_TYPE=q8_0 压一压。
#
# 想「完全不花钱」又不想装模型？把上面两个 key 都留空：系统自动退化为纯 BM25
# 关键词检索（api.py 的 build_dense 会算成 False），配合 qa(..., mode="search")
# 就是零模型、零网络、零成本 —— 既有评测的两条臂本来就是这么跑的。
