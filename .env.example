# 复制为 .env 后填入真实密钥。.env 已被 .gitignore 忽略，切勿提交。

# ---------- 生成模型（OpenAI 兼容端点）----------
# 通义百炼: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1   model=deepseek-chat
# 智谱:     https://open.bigmodel.cn/api/paas/v4   model=glm-4-plus
#
# 免费额度按**模型**算，耗尽时返回 403 Free quota exhausted —— 换个模型即可，不必换 key。
# 但**这份表会过期，先探再选**：2026-09-20 实测这份 key 的状态（括号是 09-19 的样子）：
#
#   qwen3-max     额度耗尽
#   qwen-max      额度耗尽   （09-19 还可用）
#   qwen-plus     额度耗尽
#   qwen-turbo    额度耗尽   （09-19 还可用）
#   qwen-flash    可用      ← 默认取它：最快
#   qwen3.6-flash 可用      ← 思考型
#   qwen3.7-flash 可用      ← 思考型
#
# 一天之内四个模型见底。所以默认值只保证「今天开箱能跑」，不保证下周还能跑。
#
# **别只看单次问答的速度挑模型**，那条路径量不出真差距。同一道多跳题跑完整路径
# （检索 + 生成 + agent 循环）实测：
#
#   qwen-flash   6.0s   |  qwen-max  14.0s  |  qwen3.8-max  **276.5s**
#
# qwen3.8-max 在只有一两句的短问答上只比 qwen-flash 慢 2.6 倍，但上下文一长
# （检索出的证据、工具返回）就慢到 **46 倍** —— 思考模型的推理开销随上下文放大。
# 63 题的多跳评测用它要 4.8 小时，用 qwen-max 只要 20~35 分钟。
#
# ⚠️ **`qwen-flash` 这个默认有个已知代价，跑评测之前必须知道。** agent 那一臂的价值
#    建立在**多轮规划**上（检索词是模型自己写的），规划模型一弱这地方就先垮 ——
#    2026-09-20 两处实测都指向同一边（共同点是都换成 `qwen-turbo`）：多跳 agent 首轮
#    43→37（n=100）、单跳首轮 hit@1 73.2%→68.3%（n=82）。各自都在噪声内，但方向一致。
#    所以：**跑服务用它没问题；跑 rag vs agent 的评测就换旗舰档**，否则被削弱的
#    正是你要对比的那个东西。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-flash
LLM_TEMPERATURE=0.2

# ---------- 向量模型 ----------
# 默认指向**本地 Ollama**：README 里那组 hit@k 就是用它测的，云端换模型复现不出同一组数。
# 装法见本文件末尾「本地模型」一节。不想装 Ollama 就改用下面注释掉的云端配置。
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
# 注意模型名带命名空间：bge-large-zh-v1.5 在 Ollama 上没有官方库，只有社区仓库，
# 所以 pull 时要连 `dengcao/` 一起写，只写 bge-large-zh-v1.5 会 404。
# （拉不到就退回官方库的 bge-m3，同为 1024 维，两个名称都无需命名空间。）
EMBED_MODEL=dengcao/bge-large-zh-v1.5
# 向量维度：**本地端点必须留空**。非空会作为 dimensions 参数发给端点，Ollama 不认会 400。
# 维度不靠它定 —— kb/indexer.py 是从实际返回的向量长度推 dim 再建 schema 的。
EMBED_DIM=
# 单次请求最多提交多少条文本。本地没有服务商侧的条数限制，调大只是少几次往返。
EMBED_BATCH=32
# 只加在**查询**上的指令前缀，段落侧绝不加。bge-zh 系列就是按这个用法训练的。
# 135 题实测（同一索引，只差这一项）：hit@1 69.6%→71.1%、hit@6 87.4%→90.4%、
# MRR 0.7667→0.7826，hit@3 持平 —— 四项里三项变好、一项不动，所以默认开着。
# 换成 text-embedding-v4 这类不吃前缀的模型时留空即可，空值 = 与加这功能之前逐位相同。
# 改它**不需要重建索引**：只影响查询怎么编码，库里的段落向量与它无关。
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
#
# === 云端向量（text-embedding-v4 / 智谱 embedding-3 / OpenAI text-embedding-3-small）===
# 注意：DeepSeek 不提供 embedding 接口，混用时必须单独配一家。
# **别图省事把 EMBED_API_KEY 留空** —— 留空会回退吃 LLM_API_KEY（config.embed_config 的兜底），
# 于是「换个生成模型」会顺手把向量侧也打断，而 traffic_law 集合是用 EMBED_MODEL 建的。
# 换向量模型 = 全库重建 + 既有基线数字全部作废 —— 这一步现在**会**自动发生：
# api.py 的 _stale_reason 会比对快照里的 embedding_model 与当前配置，不一致就重建。
# （补这条之前它是静默的：v4 与 bge-large 都是 1024 维，行数也不变，一路放行。）
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v4
# EMBED_DIM=1024
# EMBED_BATCH=10
# 云端这家不吃指令前缀，**留空**。（前缀不进 embedding_model 快照，所以切模型时
# _stale_reason 不会因为这一项判过期 —— 这是对的，它只影响查询编码，动不了库里的向量。）
# EMBED_QUERY_PREFIX=

# ---------- 检索参数 ----------
# 最终返回给 LLM 的法条数（父块，按条计）
RAG_TOP_K=6
# 每个召回通道各取多少候选
RAG_CANDIDATES=20
# Milvus RRFRanker 的平滑常数
RAG_RRF_K=60
# 查询命中法名片段（如"深圳""智能网联汽车"）时，对应法规条文的分数加成；设为 1.0 关闭
RAG_LAW_HINT_BOOST=1.5

# ---------- Agent 循环（阶段二，仅 `python -m traffic_law_qa "问题" --agent` 用）----------
# 线性管道 qa(mode="ask") 不读这一段，改了不影响基线。
# 循环参数只由这里说了算；检索参数（上面那组 RAG_*）仍是唯一真源 ——
# Agent 不许悄悄换一套检索参数，否则和基线的对照就不是同一个检索了。
# 规划轮数上限（= LLM 规划调用次数上限）。规则取条那条路不耗这个预算。
# 默认 3。**下面那个「2 就够、第 3 轮白花钱」的旧实测已经不作数**：它量的是旧的两节点循环
# （规划 + 独立审核），那时第 2 轮的检索词来自审核写出的 next_query；本仓后来把审核并进了
# 规划轮（README 有溯源），第 2 轮改由规划轮自己从上一轮结果里推 —— 第 3 轮值不值钱，在
# 新形状上**没量过**。旧数留着当量级参考：100 题多跳集上第 2 轮把条目级命中从 72/200 抬到
# 78/200，第 3 轮只再抬 2 条（78→80），却多花 35 次检索 + 35 次规划调用。
# 想省钱、或想复现那套旧数，显式写 2。一轮的最坏花费：规划调用（零证据的停会重问一次，
# 最多 2 次）+ 1 次检索；预算尽时不再多问一次模型，直接进作答。
AGENT_MAX_STEPS=3
# 最终证据条数；0 = 沿用 RAG_TOP_K
AGENT_MAX_EVIDENCE=0
# 搜索结果里每条法条的摘要字数
AGENT_SNIPPET_CHARS=120
# 精确取条（get_article）的摘要字数，比检索摘要大：用户点名要看这一条，
# 切太短会把列举型法条里的关键项切掉
AGENT_ARTICLE_CHARS=400
# 规划轮温度：要它稳定选词，不要它发挥
AGENT_TEMPERATURE=0.0
AGENT_RETRIES=2
# 末端复核的拦截阈值：答案里每个 [依据N] 被它引的原文支撑的比例低于它就**不直接输出**，
# 降级为「依据不足」+ 候选法条，并标记需人工复审。
#   < 0  关掉复核节点（连模型都不调）
#    0   只打分不拦截（跑批看分数分布用）
#   > 0  才拦（判据是严格小于：正好等于阈值不拦）
# **0.6 是占位值，不是标定值** ——「正确率 / 拒答率」两条曲线还没跑（要烧额度）。
# 今天能说的量级：真答案里引用编号个数 ≤3 的占 70%，多数题错 1 条就会被拦下来。
# 分数怎么算、判据怎么来的，见下面「末端复核」那一节与 agent/review.py。
AGENT_REVIEW_MIN_SCORE=0.6

# ---------- 入口裁决专用模型（可选）----------
# 入口那一步判「这道题该按哪个地区的规定回答」，是全循环唯一一处「判断题 + 严格 JSON
# 输出」，要的是判得准且便宜；循环本身要的是会调工具、也会自己判断什么时候停，
# 两者不是一回事 —— 所以只把入口这一半摘出去，循环仍用上面的 LLM_*。
#
# 三项**逐字段回退**到 LLM_*：不写 = 与单模型时逐位相同；写了哪项才覆盖哪项。
# 同一家、只想换个免费额度没用完的模型时，只写 AGENT_REGION_MODEL 就行
# （百炼的免费额度是按模型算的）。
#
# **实测的取向：入口要用快而小的，别用思考型。** 2026-09-22 同一道题、同一套循环，
# 只换 AGENT_REGION_MODEL 一项（这只与 LLM_* 同家，所以只写这一项就够）：
#
#   qwen3.7-flash（思考型）   入口 25.60s   一次提问 63.4s
#   tongyi-intent-detect-v3   入口  3.47s   一次提问 13.0s
#
# 判地区是一道是非题、输出只有一段 JSON —— 思考型在这里纯亏，25 秒里 24 秒花在推理上。
# 那一格原本占一次提问的 **40%**，所以这不是零头。
#
# ⚠️ **「快」不等于「稳」——上面那格 3.47s 是同一天早些时候的数，晚上就被推翻了。**
#    同题同模型有一次滑进复读：吐了 24901 字、烧掉 14464 个 token、占住 223 秒，JSON 还被
#    截断成解析失败（退回 `?`），一次提问 231 秒里 223 秒是它。根因是当时提示词让它多写一句
#    `reason`，它就在那一句里「……因此……因此……」停不下来。现在提示词只要 `region` 一个
#    字段，且 `agent/llm.py` 给**每一次**调用都加了兜底上限（timeout=30s、max_tokens=1024，
#    代码里的默认值，不是这里的 env 键）。改后同题实跑 4 次：2.64~3.38 秒、完成 5 个 token、
#    JSON 干净。**留着这只模型是因为上限兜得住，不是因为 3.47 秒那个数可信。**
#
# 三个非显然的点，换之前先看：
# 1) **「不在模型列表里」不等于不能用。** 它不在兼容模式的 `GET /models` 里（261 个模型
#    里含 intent 的零个），但照样调得通 —— 那个列表不列全部可用模型，别拿它当门禁。
# 2) **入口裁决今天对检索结果没有影响。** 库内 4 部国家法 + 2 部深圳条例，而
#    `law_scope("深圳")` = 国家法 ∪ 深圳条例 = 6 部 = 全库，返回 `?` 也是全库 ——
#    判「深圳」「?」「广州」，检出来的条文逐条相同。所以这一格换模型是**纯延迟决定，
#    不是质量决定**；等库里出现第二个地区，它才第一次有后果，那时才需要量准确率。
# 3) 它吃的是**新用户赠送的 100 万 tokens / 90 天**（每次约 640 token ≈ 1500 次判定），
#    到期后政策未知。换回来只是改这一个键。
#
# ⚠️ **模型名不跨家**：下面这个 glm-4.7-flash 只能配智谱的 base_url。只改模型名而
#    base_url 还指着百炼的话，端点会直接 400 —— 好在失败是响的，不会静默劣化。
#
# 另一条免费路（要新注册一家）：智谱 GLM-4.7-Flash，永久免费（不限量，不是送额度）。
# 但它是**混合思考模型、默认开思考**，要它快就得传 thinking={"type":"disabled"} ——
# 而 `agent/llm.py` 现在没有透传 extra_body 的口子，今天要么接受它慢、要么先改代码。
# 到 https://open.bigmodel.cn 注册拿 key；免费档有独立并发限速，被限会 429。
# AGENT_REGION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENT_REGION_API_KEY=
# AGENT_REGION_MODEL=glm-4.7-flash
#
# 一个坑先记在这：思考模型把思维链放在 reasoning_content、正文仍是干净 JSON，客户端
# 吃得下。但若换成把思考**塞进正文**的端点，思维链里的花括号会让 `_parse_region`
# 的「首个 { 到末个 }」取错范围 —— 而它的兜底是 `?`（不限地区），表现为检索范围比该有
# 的宽。真换的时候先看轨迹里那行「地区：」。
#
# 这三个键 2026-09 之前叫 AGENT_REFLECT_*（当时的服务对象是审核节点，那个节点已并入
# 循环）。**旧名字不再被读取** —— 留着旧键的 .env 会静默回退到 LLM_*。

# ---------- 末端复核专用模型（可选）----------
# 收尾节点产出答案之后，复核节点逐个 [依据N] 判断「它引的那条原文撑不撑得住那句结论」，
# 分低就把答案换成「依据不足」+ 候选法条并标记需人工复审。阈值见上面的
# AGENT_REVIEW_MIN_SCORE，口径与失败处理见 agent/review.py。
#
# **模型只给逐条判据，分数由代码算**（支撑条数 / 答案引用到的编号个数；引了越界编号
# 也计入分母且永不支撑）。所以换这里只影响「判得准不准」，不影响口径。
#
# 三项**逐字段回退**到 AGENT_REGION_*，再往下一层是 LLM_*：不写 = 用入口那只。
# 默认复用入口模型是有意的 —— 复核与入口是同一类活（一次调用、一段短 JSON，要判得准且
# 便宜），而**它不该是主模型**：让生成答案的那只模型给自己的答案打分，就是自己判自己。
# ⚠️ 但回退链的尽头是主模型 —— **AGENT_REGION_* 与 AGENT_REVIEW_* 都不写时，复核会落到
#    LLM_* 上，等于自己判自己**。那只够验证链路通不通，不适合拿它的分数出数。
#    `python -m traffic_law_qa "问题" --agent` 开头那行会打出复核用的是哪只模型，扫一眼就知道。
#
# 成本：每次提问多 1 次调用（输入是答案全文 + 被引法条原文，输出不到 200 token）。
# 入口那只实测 3 秒级；**别换成思考型** —— 这是判断题，思考型的推理时间在这里纯亏
# （同一节上面那组入口实测同理）。
#
# 复核自己坏掉一律**放行**（没模型 / 解析失败 / 调用抛异常都原样输出，只留一行
# 「复核未完成」在轨迹里）：它是闸不是依赖，唯一拦得住的理由是「分真的低」。
#
# ⚠️ **机制通了，检测力没证 —— 别把这只模型当已经能用的审查。** 2026-09-22 用一条真答案探的：
#    往它引的一条依据后面追一句该条原文里没有的话（「…第三十四条 还规定并处 12345 元罚款…
#    [依据2]」，先断言原文里没有这个数），**入口这只模型两次都判「支撑」**（补提示词规则前后
#    各一次，输入逐字节相同）。同一批调用里它还替**没列出的编号**编判据（只列了 2~5，它回 1~6）。
#    所以：默认阈值下今天这道闸**基本拦不住「追加库外内容」这一类**（其他类没探过）。
#    要真做起来，三条路（都不是改提示词就完事）：换更强的复核模型、加一层代码校验
#    （如答案里的数额/记分是否在所引原文里出现过）、按正确率/拒答率标定阈值 —— 后者是下一步。
#
# AGENT_REVIEW_BASE_URL=
# AGENT_REVIEW_API_KEY=
# AGENT_REVIEW_MODEL=

# ---------- 云端观测（可选；配了下面两个 key 就自动开）----------
# 把节点状态、模型调用与检索上报到 Langfuse，用来在面板上按树看一次提问是怎么走的。
# **配了就开**：凡是要真跑 agent 的路径 —— `python -m traffic_law_qa "问题" --agent`、
# `…eval.singlehop` / `…eval.multihop` —— 都自动上报，不用加开关。
# 想安静：agent 命令行加 `--no-langfuse`；代码里显式传 `tracer=Tracer()`（obs.py 的空实现）；
# 跑评测（eval.singlehop / eval.multihop）没有开关，要安静就把下面两个 key 注释掉。
#
#   pip install -e ".[langfuse]"      # 单独一个 extra，不在 all 里
#
# 到 https://cloud.langfuse.com 注册、建个项目就有这两个 key（免费档够用）。**建项目时选的
# 区决定了下面的 host，两边必须一致** —— 本项目在 JP 区，见文件末尾那行 LANGFUSE_HOST。
# 注意送上去的是**题目原文、提示词、法条片段与模型输出** —— 都要过云端，
# 别拿它跑不该外发的题。两个 key 没配时一个客户端都不建、一个字节都不外发。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# ⚠️ **host 要和建项目时选的区对上 —— 对不上报 401，看着像 key 错，其实是区错**（本项目
#    踩过：项目开在 JP 区、host 留在默认的 EU 上，一路 401）。本项目用 JP 区，照下面这行填；
#    换别的区就换成该区的 host。自建实例填自己的地址。
# LANGFUSE_HOST=https://jp.cloud.langfuse.com

# ---------- Milvus（先 docker compose up -d standalone）----------
# 这个 localhost 是给**宿主机裸跑**（pip install -e . 后直接 python -m ...）用的。
# 跑在容器里时 localhost 指容器自己，必须换成服务名 —— docker-compose.yml 的 app
# 服务已经在 environment 里覆盖成 http://standalone:19530，这里不用改。
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=traffic_law
# 文本分析器：jieba 支持中文分词；置空则用 standard（中文会退化成单字，不推荐）
MILVUS_ANALYZER=jieba
# BM25 参数：k1 控制词频饱和（推荐 1.2~2.0），b 控制长度归一化（0~1）
MILVUS_BM25_K1=1.2
MILVUS_BM25_B=0.75

# ---------- 本地模型（Ollama）----------
# 向量侧**默认就走这里**（见上面「向量模型」一节）；这一节说怎么装，以及要不要
# 把「生成」也搬过来。两个 client 都是纯 OpenAI 兼容接口（/chat/completions 与
# /embeddings），换本地只是改地址，代码零改动。
#
# 本机实测：RTX 3050 Laptop / **4GB 显存**。
#
#   ollama pull dengcao/bge-large-zh-v1.5   # 向量：326M 参数 / FP16 约 650MB
#   装到 D 盘（C 盘紧张时）：安装器带 /DIR，模型另用 OLLAMA_MODELS 指过去 ——
#   后者是**服务启动时**读的，改完要重启 ollama 才生效。
#
# 早先这版注释写的是「4GB 上只能配 bge-small-zh-v1.5」，那有个前提：**同时**在本地
# 跑生成模型。只跑向量时 650MB 对 4GB 绰绰有余，这个取舍不必做 —— bge-small 只有
# 24M 参数，中文检索质量比 bge-large 差一截。
#
# bge-large-zh-v1.5 在 Ollama 上只有社区仓库（dengcao/ 、tisandman/ 等），没有官方版。
# 拉不到就退回官方库的 bge-m3（1.2GB / 同为 1024 维），后续步骤完全不变。
#
# === 可选：生成也本地化（与向量共用一张卡时要算总账）===
#   ollama pull qwen3:4b      # Q4 量化约 2.5GB
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama          # 非空即可 —— config 的 ready 就是 bool(api_key)，Ollama 不校验
# LLM_MODEL=qwen3:4b
# 此时 bge-large（约 650MB）+ qwen3:4b（约 2.5GB）≈ 3.2GB，加 KV cache 逼近 4GB，
# 得设 OLLAMA_MAX_LOADED_MODELS=1 让两者换入换出（慢，但能跑）。
#
# 换生成模型不动任何既有数字 —— 评测的 135 题与 100 题两条臂**根本不调用 LLM**。
# 换向量模型正相反：traffic_law 集合必须全库重建、既有基线全部作废
#（现在这一步会自动发生，_stale_reason 会比对快照里的 embedding_model）。
#
# 两条注意：
# 1) agent 那条路走 OpenAI 工具调用协议，需要模型支持 function calling。
#    qwen3 系列支持，但 4B 这么小的模型多轮规划会明显退化 —— 而 100 题对照
#    已经证明 agent 的价值本来就在多轮检索上。纯问答 qa(mode="ask") 没这要求。
# 2) 显存不够时 Ollama 会溢出到共享内存，速度崩到 1~3 tok/s。可用
#    OLLAMA_MAX_LOADED_MODELS=1 与 OLLAMA_KV_CACHE_TYPE=q8_0 压一压。
#
# 想「完全不花钱」又不想装模型？把上面两个 key 都留空：系统自动退化为纯 BM25
# 关键词检索（api.py 的 build_dense 会算成 False），配合 qa(..., mode="search")
# 就是零模型、零网络、零成本 —— 既有评测的两条臂本来就是这么跑的。
