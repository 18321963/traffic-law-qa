
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-flash
LLM_TEMPERATURE=0.2

# 嵌入与重排都在进程内跑（transformers + 本地权重 法规知识库/models/），没有远端端点。
# 默认路径就是下面两个模型的目录名，换模型才需要设：
# EMBED_MODEL=            # 默认 <包同级>/法规知识库/models/bge-m3
EMBED_BATCH=10
EMBED_MAX_LENGTH=512
EMBED_DEVICE=auto
EMBED_DTYPE=auto

RAG_TOP_K=6
RAG_CANDIDATES=20
RAG_RRF_K=60
RAG_LAW_HINT_BOOST=1.5

# RRF 之后接交叉编码器重排（bge-reranker-v2-m3）；RAG_RERANK=0 退回纯融合序
RAG_RERANK=1
# 0 = 整池重排（score 口径统一）；设 k 只重排前 k 篇
RAG_RERANK_TOP_N=0
RAG_RERANK_BATCH=8
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_DEVICE=auto
RAG_RERANK_DTYPE=auto
# RAG_RERANK_MODEL=      # 默认 <包同级>/法规知识库/models/bge-reranker-v2-m3

AGENT_MAX_STEPS=3
AGENT_MAX_EVIDENCE=0
AGENT_SNIPPET_CHARS=120
AGENT_ARTICLE_CHARS=400
AGENT_TEMPERATURE=0.0
AGENT_RETRIES=2
AGENT_REGION_BASE_URL=
AGENT_REGION_API_KEY=
AGENT_REGION_MODEL=
AGENT_REVIEW_BASE_URL=
AGENT_REVIEW_API_KEY=
AGENT_REVIEW_MIN_SCORE=0.6
AGENT_REVIEW_MODEL=

LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_COUNT=5
BOCHA_FRESHNESS=noLimit
BOCHA_TIMEOUT=15.0

MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=traffic_law
MILVUS_ANALYZER=jieba
MILVUS_BM25_K1=1.2
MILVUS_BM25_B=0.75
