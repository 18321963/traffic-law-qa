# 复制本文件为 .env 后填入真实值：
#     Copy-Item .env.example .env
# .env 已被 .gitignore 排除，不会进仓库；本文件（.env.example）会入库作为模板。

# ---- 大模型 API ----
# 按你实际使用的服务商填写，切勿把真实 Key 写进本文件
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---- 检索库（后续构建 SQLite 时使用）----
DB_PATH=法规知识库/law.db
