# 复制为 .env 后填入真实密钥。.env 已被 .gitignore 忽略，切勿提交。

# ---------- 生成模型（OpenAI 兼容端点）----------
# DeepSeek: https://api.deepseek.com/v1   model=deepseek-chat
# 通义百炼: https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# 智谱:    https://open.bigmodel.cn/api/paas/v4   model=glm-4-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ---------- 向量模型 ----------
# 注意：DeepSeek 不提供 embedding 接口，需要单独配一家（通义百炼 / 智谱 / OpenAI）。
# 留空则回退复用上面的 LLM_BASE_URL / LLM_API_KEY（仅当该端点支持 /embeddings 时才可行）。
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
# 通义 text-embedding-v4 / 智谱 embedding-3 / OpenAI text-embedding-3-small
EMBED_MODEL=text-embedding-v4
# 向量维度；留空则使用模型默认维度，首次建库后会写回 index/index_meta.json
EMBED_DIM=1024
# 单次请求最多提交多少条文本（各家限制不同，通义 v4 为 10）
EMBED_BATCH=10

# ---------- 检索参数 ----------
# 最终返回给 LLM 的法条数（父块，按条计）
RAG_TOP_K=6
# 每个召回通道各取多少候选
RAG_CANDIDATES=20
# RRF 融合常数
RAG_RRF_K=60
# 向量通道权重、BM25 通道权重
RAG_VECTOR_WEIGHT=1.0
RAG_BM25_WEIGHT=1.0
# 查询命中法名片段（如"深圳""智能网联汽车"）时，对应法规条文的分数加成；设为 1.0 关闭
RAG_LAW_HINT_BOOST=1.5
