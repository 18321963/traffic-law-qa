# frontend 侧变量（复制为 .env.local 后按需改；不带真实密钥入库）
# 数据来源：mock＝内置示例数据（默认，不连服务、不外呼）；live＝直连 HTTP 服务
VITE_API_MODE=mock

# 服务基地址。留空＝同源（开发时走 vite 代理，代理目标见 VITE_API_TARGET）
VITE_API_BASE=

# 开发代理目标（agent 服务）
VITE_API_TARGET=http://127.0.0.1:8001

# 回答通道：agent＝经 Agent 编排；rag＝仅 RAG 通道（恒同源 /rag，开发时经下面的代理）
VITE_API_CHANNEL=agent

# 开发代理目标（rag 服务；仅 RAG 通道用，/rag 前缀由代理剥掉）
VITE_RAG_TARGET=http://127.0.0.1:8000

# 只有设了它才随请求发 X-API-Key 头；留空＝不发
VITE_AGENT_API_KEY=
